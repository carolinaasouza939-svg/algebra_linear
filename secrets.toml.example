# Renomeie este arquivo para "secrets.toml" (na mesma pasta .streamlit/) e
# preencha com sua chave de API da Anthropic. NUNCA suba o secrets.toml
# real para um repositório público — adicione-o ao .gitignore.
#
# Se você estiver hospedando no Streamlit Community Cloud, em vez de usar
# este arquivo, cole o mesmo conteúdo em:
# App settings → Secrets, dentro do painel do Streamlit Cloud.

ANTHROPIC_API_KEY = "sk-ant-sua-chave-aqui"
